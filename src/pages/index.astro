---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE, TOP_URL } from '../consts';

const latest = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">DEV BLOG</p>
				<h1>ゲーム開発<br />Dev Blog</h1>
				<p class="lead">
					個人開発者・伊藤颯一が制作中のゲームやアプリの進捗、Unityの技術メモを記録していくブログです。
				</p>
				<div class="actions">
					<a class="btn btn-primary" href="/blog/">記事を読む</a>
					<a class="btn btn-outline" href={TOP_URL}>プロフィールサイト</a>
				</div>
			</section>

			<section class="latest">
				<h2>最新の記事</h2>
				<ul>
					{
						latest.map((post) => (
							<li>
								<PostCard post={post} />
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 24px 0 56px;
		border-bottom: 1px solid var(--border);
	}
	.eyebrow {
		margin: 0 0 12px;
		font-family: var(--mono);
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--accent);
	}
	.hero h1 {
		margin: 0;
		font-size: 3rem;
		line-height: 1.2;
		letter-spacing: -0.03em;
	}
	.lead {
		max-width: 480px;
		margin: 24px 0 0;
		color: var(--text-dim);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 32px;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		padding: 11px 22px;
		border: 1px solid transparent;
		border-radius: 6px;
		font-size: 14px;
		font-weight: 500;
		text-decoration: none;
		transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}
	.btn-primary {
		background: var(--accent);
		color: #ffffff;
	}
	.btn-primary:hover {
		background: var(--accent-dark);
		color: #ffffff;
	}
	.btn-outline {
		border-color: var(--border);
		color: var(--text);
	}
	.btn-outline:hover {
		border-color: var(--accent);
		color: var(--text-h);
		transform: translateY(-1px);
	}
	.latest {
		padding-top: 48px;
	}
	.latest h2 {
		margin: 0 0 28px;
		padding: 0;
		border: none;
		font-size: 1.3rem;
	}
	.latest ul {
		display: flex;
		flex-direction: column;
		gap: 28px;
		margin: 0;
		padding: 0 6px 0 0;
		list-style: none;
	}
	.latest li {
		margin: 0;
	}

	@media (max-width: 720px) {
		.hero {
			padding-bottom: 40px;
		}
		.hero h1 {
			font-size: 2.2rem;
		}
	}
</style>
