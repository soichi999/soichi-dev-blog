---
import { TOP_URL } from '../consts';
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer class="site-footer">
	<SocialLinks />
	<p>
		&copy; {today.getFullYear()} 伊藤颯一 / <a href={TOP_URL}>プロフィールサイト</a>
	</p>
</footer>

<style>
	.site-footer {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		padding: 32px 24px 40px;
		border-top: 1px solid var(--border);
		color: var(--text-dim);
		font-family: var(--mono);
		font-size: 12px;
	}
	.site-footer p {
		margin: 0;
		text-align: center;
	}
	.site-footer a {
		color: inherit;
	}
</style>
