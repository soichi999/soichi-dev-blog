---
import { SITE_TITLE, TOP_URL } from '../consts';
import SocialLinks from './SocialLinks.astro';

const path = Astro.url.pathname;
const links = [
	{ href: '/', label: 'ホーム', active: path === '/' },
	{ href: '/blog/', label: 'ブログ', active: path.startsWith('/blog') },
	{ href: '/about/', label: 'About', active: path.startsWith('/about') },
	{ href: TOP_URL, label: 'プロフィールサイト', active: false },
];
---

<header class="site-header">
	<div class="bar">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<nav aria-label="メイン">
			{
				links.map((link) => (
					<a href={link.href} class:list={{ active: link.active }}>
						{link.label}
					</a>
				))
			}
		</nav>
		<div class="social">
			<SocialLinks />
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--accent);
		color: #ffffff;
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		max-width: 1080px;
		margin: 0 auto;
		padding: 0 24px;
	}
	.brand {
		flex-shrink: 0;
		padding: 18px 0;
		color: #ffffff;
		font-weight: 700;
		font-size: 15px;
		text-decoration: none;
	}
	nav {
		display: flex;
		gap: 28px;
		margin-left: auto;
	}
	nav a {
		padding: 18px 0 14px;
		color: #ffffff;
		font-size: 14px;
		font-weight: 700;
		text-decoration: none;
		border-bottom: 4px solid transparent;
		white-space: nowrap;
	}
	nav a:hover,
	nav a.active {
		border-bottom-color: #ffffff;
	}
	.social {
		color: #ffffff;
	}

	@media (max-width: 720px) {
		.bar {
			flex-wrap: wrap;
			gap: 0 16px;
			padding: 0 18px;
		}
		.brand {
			padding: 12px 0 4px;
		}
		.social {
			display: none;
		}
		nav {
			flex: 1 0 100%;
			margin-left: 0;
			gap: 18px;
			overflow-x: auto;
			scrollbar-width: none;
		}
		nav::-webkit-scrollbar {
			display: none;
		}
		nav a {
			padding: 6px 0 8px;
			font-size: 13px;
		}
	}
</style>
